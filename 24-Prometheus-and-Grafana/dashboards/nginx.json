{
  "dashboard": {
    "uid": "nginx-overview",
    "title": "Nginx - Overview",
    "tags": ["nginx", "web-server"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_active",
            "legendFormat": "active",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 500 },
                { "color": "red", "value": 1000 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Connections Waiting",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_waiting",
            "legendFormat": "waiting",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 200 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Connections Reading",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_reading",
            "legendFormat": "reading",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Connections Writing",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_writing",
            "legendFormat": "writing",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Total Accepted Connections",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_accepted",
            "legendFormat": "accepted",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Total Handled Connections",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_connections_handled",
            "legendFormat": "handled",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "nginx_http_requests_total",
            "legendFormat": "requests",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Requests Per Second",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total[5m])",
            "legendFormat": "req/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 100 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        }
      }
    ],
    "schemaVersion": 39
  },
  "folderId": 0,
  "overwrite": true
}
